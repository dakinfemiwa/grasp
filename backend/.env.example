# Local PostgreSQL. Managed providers' postgres:// URLs are accepted as-is.
# With Neon, `neon env pull` writes DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED
# (direct) to the repo-root .env, which overrides this file.
DATABASE_URL=postgresql+psycopg://grasp:grasp@localhost:5432/grasp
# Direct connection for Alembic migrations (optional; defaults to DATABASE_URL).
# DATABASE_URL_UNPOOLED=
# Comma-separated allowed browser origins.
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
# Clerk Frontend API URL for the Grasp Clerk app
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
